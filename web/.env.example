# Copy to .env and adjust.

# mock = in-browser simulated exchange (no backend needed)
# rest = talk to the real engine over HTTP
VITE_API_MODE=mock

# Base URL the REST client prefixes every route with.
# Leave as /api in dev so requests go through the Vite proxy below.
VITE_API_URL=/api

# How often (ms) the UI polls book / trades / open orders.
VITE_POLL_MS=500

# Where the dev proxy forwards /api/* (your engine's HTTP server).
API_PROXY_TARGET=http://localhost:8080
